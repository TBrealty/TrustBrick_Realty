# Copy to .env.local and fill in. See README → Environment variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App runtime role: data access only (SELECT/INSERT/UPDATE/DELETE), no DDL.
DATABASE_URL=postgres://trustbrick_app:app_dev_only@127.0.0.1:5434/trustbrick
# Migration role: owns the schema. Used by drizzle-kit only, never by the app.
DATABASE_URL_MIGRATIONS=postgres://trustbrick_owner:owner_dev_only@127.0.0.1:5434/trustbrick

BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Uploaded photos, videos and documents. "local" writes to STORAGE_LOCAL_DIR. In production,
# local storage only runs when STORAGE_LOCAL_DIR is set explicitly to a persistent volume.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
