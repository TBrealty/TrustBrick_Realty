# Copy to .env.local and fill in. See README → Environment variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App runtime role: data access only (SELECT/INSERT/UPDATE/DELETE), no DDL.
DATABASE_URL=postgres://trustbrick_app:app_dev_only@127.0.0.1:5434/trustbrick
# Migration role: owns the schema. Used by drizzle-kit only, never by the app.
DATABASE_URL_MIGRATIONS=postgres://trustbrick_owner:owner_dev_only@127.0.0.1:5434/trustbrick

BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Uploaded photos, videos and documents. "local" writes to STORAGE_LOCAL_DIR. In production,
# local storage only runs when STORAGE_LOCAL_DIR is set explicitly to a persistent volume.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# STORAGE_DRIVER=s3 for S3-compatible storage (S3, Cloudflare R2, MinIO). See docs/mobile-api.md.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Push notifications to the Trustbrick app, through Expo's push service.
# expo (default in production) | log (default otherwise: only logs) | off
# PUSH_DRIVER=log
# EXPO_ACCESS_TOKEN=
# Enables POST /api/internal/push for a scheduler to retry unsent pushes.
# PUSH_CRON_SECRET=
