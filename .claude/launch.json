{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trustbrick-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "trustbrick-app-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "mobile", "run", "web", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "trustbrick-app-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "mobile", "run", "start", "--", "--dev-client", "--port", "8081"],
      "port": 8081
    }
  ]
}
