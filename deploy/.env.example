# Production settings for deploy/docker-compose.yml. On the server:
#   cp .env.example .env && nano .env      (never commit .env)
# Generate each secret with:  openssl rand -base64 32 | tr -d '/+=' | head -c 40

# ── The site ──────────────────────────────────────────────────────────────────
# The domain only, no https://. www.trustbrick.org redirects to it.
DOMAIN=trustbrick.org
# Let's Encrypt writes here about the HTTPS certificate (expiry problems).
ACME_EMAIL=

# Signs sessions. Changing it signs everyone out. At least 32 characters.
BETTER_AUTH_SECRET=

# ── Database (Amazon RDS for PostgreSQL) ──────────────────────────────────────
# The RDS endpoint: RDS → Databases → your database → Connectivity & security → Endpoint.
DB_HOST=
# The master user and password you chose when creating the database. Only rds-init.sh uses
# them (once); the site itself signs in with the two logins below.
DB_MASTER_USER=postgres
DB_MASTER_PASSWORD=
# rds-init.sh creates these two logins with these passwords. Letters and numbers only
# (they go into connection URLs).
TRUSTBRICK_OWNER_PASSWORD=
TRUSTBRICK_APP_PASSWORD=

# ── Uploads: photos, videos, documents, tours ─────────────────────────────────
# s3: an S3 bucket, using the server's IAM role (no keys needed on EC2). Recommended.
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=ap-south-1
# Or keep them on this server's disk instead (back the disk up!):
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=/data/storage

# ── Email (Amazon SES, using the server's IAM role) ────────────────────────────
EMAIL_DRIVER=ses
# An address on your domain, verified in SES.
EMAIL_FROM="Trustbrick <no-reply@trustbrick.org>"
SES_REGION=ap-south-1

# ── App push notifications (Expo) ─────────────────────────────────────────────
PUSH_DRIVER=expo
# From expo.dev → Account settings → Access tokens (optional, recommended).
EXPO_ACCESS_TOKEN=

# ── Scheduled jobs (deploy/crontab calls these) ───────────────────────────────
# Two different random secrets.
PUSH_CRON_SECRET=
CRON_SECRET=
