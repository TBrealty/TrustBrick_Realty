{
  "expo": {
    "name": "Trustbrick",
    "slug": "trustbrick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trustbrick",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "in.trustbrick.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2EEE6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.trustbrick.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F2EEE6",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#12151B"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#B0502C"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Trustbrick uses the camera to take 360° photos of rooms for virtual tours.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Trustbrick uses motion to guide you while taking a 360° photo of a room."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trustbrick uses your location to pin a property on the map while you're there."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72baa411-e3ab-43be-9300-b94a4b417a25"
      }
    },
    "owner": "trustbrick_realty"
  }
}
