{
  "name": "trustbrick-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "images:optimize": "node scripts/optimize-images.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:reference": "node --experimental-strip-types --no-warnings=ExperimentalWarning db/seed/reference.mjs",
    "db:seed:sample": "node --experimental-strip-types --no-warnings=ExperimentalWarning db/seed/sample-listings.mjs",
    "db:seed:dev": "node --experimental-strip-types --no-warnings=ExperimentalWarning db/seed/dev-workspaces.mjs",
    "admin:bootstrap": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/admin-bootstrap.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
